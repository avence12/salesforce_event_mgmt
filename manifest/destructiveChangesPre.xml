<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs BEFORE the main payload, and the ordering is the whole point.

  Exported_Count__c is a roll-up that filters on Status__c = 'Exported'. The main
  payload ships a Status__c picklist that no longer has that value, so if the field
  were still present when it landed, the deploy would fail on a filter referencing a
  value that no longer exists. Removing the roll-up first clears the way.

  Nothing else belongs here: everything in destructiveChangesPost.xml is referenced
  by metadata the main payload updates, so those must go afterwards.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>Marketing_Event__c.Exported_Count__c</members>
        <name>CustomField</name>
    </types>
    <version>61.0</version>
</Package>

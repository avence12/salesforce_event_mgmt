    <!--
      ★R8 The approver gets the yes/no and not the link, for the same reason the AM does:
      no Contact grant is made anywhere in this repo. "Is this guest already known to us?"
      is a fair question to weigh an invitation against; "which Contact are they?" is the
      org's data to release, not this project's.
    -->
    <fieldPermissions>
        <field>Event_Attendee__c.Is_Known_Contact__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Attendee__c.Source_File__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Attendee__c.Imported_On__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <!--
      ★R8 The company-grouped approval screen. This is the only Apex an approver runs, and
      it is granted here rather than on Event_AM because approving is what this set is for —
      an AM who is also somebody's approver gets it by holding both sets, which is the
      accurate description of that person rather than a widening of either role.
    -->
    <classAccesses>
        <apexClass>InviteeApprovalController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>Marketing_Event__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>

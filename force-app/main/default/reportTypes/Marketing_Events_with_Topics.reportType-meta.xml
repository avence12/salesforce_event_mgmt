<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Marketing_Events_with_Topics</fullName>
    <label>Marketing Events with Event Topics</label>
    <description>★R11 Replaces Topic__c as the way to answer "which events are tagged X" / "what
is this event tagged with" — R6 put that on the Marketing Events report type because a
multi-select cannot be filtered any other way; R11 moves Topic off the event onto its own
child object (Event_Topic__c), and this report type is the equivalent for the new shape.
Base object is the event, "with" not "with or without", matching Marketing_Events_with_Invitees.</description>
    <baseObject>Marketing_Event__c</baseObject>
    <category>other</category>
    <deployed>true</deployed>
    <join>
        <outerJoin>false</outerJoin>
        <relationship>Event_Topics__r</relationship>
    </join>
    <sections>
        <masterLabel>Marketing Event</masterLabel>
        <columns><field>Name</field><table>Marketing_Event__c</table><checkedByDefault>true</checkedByDefault></columns>
        <columns><field>Event_Date__c</field><table>Marketing_Event__c</table><checkedByDefault>true</checkedByDefault></columns>
        <columns><field>Event_Type__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>
        <columns><field>Location__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>
        <columns><field>OWNER.NAME</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>
    </sections>
    <sections>
        <masterLabel>Event Topic</masterLabel>
        <columns><field>Name</field><table>Event_Topics__r</table><checkedByDefault>true</checkedByDefault></columns>
    </sections>
</ReportType>

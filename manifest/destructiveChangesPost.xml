<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs AFTER the main payload. Each of these is still referenced by something the
  main payload rewrites, so deleting them first would fail:

    ★R5
    Invitee_Type__c            ← the report type, both reports and the approval page
    Event_History__c           ← the Event_AM permission set's object + field grants
    ContactImportController    ← the Event_AM permission set's classAccesses
    contactSelector (LWC)      ← Marketing_Event_Record_Page

    ★R3
    ApprovalConsoleController / EventExportController  ← permission set classAccesses
    approvalConsole (LWC)                              ← Marketing_Event_Record_Page
    Approved_Exports (tab)                             ← Event_Management app
    Approved_Exports (flexipage)                       ← the tab above

  Removing a component from source does NOT remove it from an org — see Part 4 of
  DEPLOYMENT.md. Without this file, a sandbox that already has R4 keeps a dead
  Event History object collecting nothing and a Contact Selector component whose
  Apex no longer compiles.

  DATA WARNING: deleting Event_History__c destroys the R4 attendance log. It has no
  equivalent in R5 by design — attendance is now the invitee row. Export it first if
  anyone has come to rely on it; Part 7 of DEPLOYMENT.md says how.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>Event_Invitee__c.Invitee_Type__c</members>
        <name>CustomField</name>
    </types>
    <types>
        <members>ApprovalConsoleController</members>
        <members>EventExportController</members>
        <members>ContactImportController</members>
        <members>ContactImportControllerTest</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>approvalConsole</members>
        <members>approvedExport</members>
        <members>contactSelector</members>
        <name>LightningComponentBundle</name>
    </types>
    <types>
        <members>Approved_Exports</members>
        <name>CustomTab</name>
    </types>
    <types>
        <members>Approved_Exports</members>
        <name>FlexiPage</name>
    </types>
    <types>
        <members>Event_History__c</members>
        <name>CustomObject</name>
    </types>
    <version>61.0</version>
</Package>

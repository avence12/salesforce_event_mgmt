    <!--
      Read-only for a user even though the import writes them: these three are the
      record's provenance, and a hand-edit would make Source_File__c a lie. The
      import runs in the user's context and can still set them, because Apex
      respects FLS only where the code asks it to — the point here is the UI.
    -->
    <fieldPermissions>
        <field>Event_Attendee__c.Source_File__c</field>

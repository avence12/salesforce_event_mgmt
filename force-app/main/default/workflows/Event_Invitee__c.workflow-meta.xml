<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Field updates invoked by the Invitee_Approval approval process. These carry the
      status state machine that InviteeSelectorController and ApprovalConsoleController
      used to run in Apex. They execute in system context, so Status__c staying
      FLS-read-only for both permission sets is unaffected.
    -->
    <fieldUpdates>
        <fullName>Set_Status_Pending_Approval</fullName>
        <name>Set Status Pending Approval</name>
        <description>Initial submission action. ★R9 Apex resolves the whole approval chain into Approver_1__c..Approver_5__c and stamps Submitted_At__c before calling Approval.process(); the status itself is written here so the picklist follows the approval, not the other way round.</description>
        <field>Status__c</field>
        <literalValue>Pending Approval</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Status_Approved</fullName>
        <name>Set Status Approved</name>
        <field>Status__c</field>
        <literalValue>Approved</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Status_Rejected</fullName>
        <name>Set Status Rejected</name>
        <field>Status__c</field>
        <literalValue>Rejected</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <!--
      ★R9 The chain's progress marker. Set_Current_Level_1 is an initial submission action;
      each of the others is the *approval* action of the step below it, which is what a step
      entry action looks like in an approval process — there is no separate entry hook, and
      "step N was approved" and "step N+1 has begun" are the same moment.

      Two things they buy, and the second is the load-bearing one. Pending_Count__c stopped
      meaning "waiting on one named person" the day the chain arrived, and Current_Level__c
      gives that answer back. And the update itself is what fires Invitee_Level_Advanced, so
      the approver at the new level hears about work that would otherwise appear in their
      Approvals list unannounced.
    -->
    <fieldUpdates>
        <fullName>Set_Current_Level_1</fullName>
        <name>Set Current Level 1</name>
        <field>Current_Level__c</field>
        <literalValue>1</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Current_Level_2</fullName>
        <name>Set Current Level 2</name>
        <field>Current_Level__c</field>
        <literalValue>2</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Current_Level_3</fullName>
        <name>Set Current Level 3</name>
        <field>Current_Level__c</field>
        <literalValue>3</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Current_Level_4</fullName>
        <name>Set Current Level 4</name>
        <field>Current_Level__c</field>
        <literalValue>4</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Set_Current_Level_5</fullName>
        <name>Set Current Level 5</name>
        <field>Current_Level__c</field>
        <literalValue>5</literalValue>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Stamp_Decided_At</fullName>
        <name>Stamp Decided At</name>
        <description>Shared by the final approval and final rejection actions — the timestamp means &quot;when a decision was reached&quot;, which is the same event either way.</description>
        <field>Decided_At__c</field>
        <formula>NOW()</formula>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
</Workflow>

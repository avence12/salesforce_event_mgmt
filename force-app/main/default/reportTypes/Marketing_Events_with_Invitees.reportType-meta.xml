        <columns><field>Approved_Count__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>
        <columns><field>Pending_Count__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>
        <columns><field>Rejected_Count__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>

    <required>false</required>
    <trackHistory>false</trackHistory>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>Name</fullName><default>false</default><label>Name</label></value>
            <value><fullName>Name + Company</fullName><default>false</default><label>Name + Company</label></value>
            <value><fullName>Name + Company + Email</fullName><default>false</default><label>Name + Company + Email</label></value>
            <value><fullName>Created by import</fullName><default>false</default><label>Created by import</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>

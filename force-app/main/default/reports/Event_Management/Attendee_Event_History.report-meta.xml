<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Attendee Event History</name>
    <description>★R6 Which events each person actually attended — the basis for recommending a similar one. Filtered to Attended = true, so approved no-shows are excluded: approval is permission to come, attendance is having come, and only the second is evidence of interest. Grouped by attendee, so the record count per group is that person&apos;s number of events. To go the other way — &quot;who attended anything tagged Payments&quot; — ★R11 use the Marketing Events with Event Topics report type instead, whose base object is the event and which joins to Event_Topic__c.</description>
    <reportType>Event_Attendees_with_History</reportType>
    <format>Summary</format>
    <scope>organization</scope>

    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Event_Attendee__c$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>

    <columns><field>Event_Attendee__c$Company__c</field></columns>
    <columns><field>Event_Attendee__c$Title__c</field></columns>
    <columns><field>Event_Attendee__c$Email__c</field></columns>
    <columns><field>Event_Invitees__r$Event_Name__c</field></columns>
    <columns><field>Event_Invitees__r$Event_Date__c</field></columns>
    <columns><field>Event_Invitees__r$Event_Type__c</field></columns>

    <filter>
        <criteriaItems>
            <column>Event_Invitees__r$Attended__c</column>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
    </filter>

    <!--
      Unfiltered on date on purpose: recency matters to a recommendation, but what
      counts as recent is the marketer's call at read time, and the report's own
      date filter is the right place for it.
    -->
    <timeFrameFilter>
        <dateColumn>Event_Invitees__r$Event_Date__c</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>

    <sortColumn>Event_Invitees__r$Event_Date__c</sortColumn>
    <sortOrder>Desc</sortOrder>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
</Report>

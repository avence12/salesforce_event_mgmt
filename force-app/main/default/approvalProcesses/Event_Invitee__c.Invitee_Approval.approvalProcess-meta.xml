<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invitee_Approval</fullName>
    <label>Invitee Approval</label>
    <active>true</active>
    <description>Screen 4. Replaces the approvalConsole LWC and ApprovalConsoleController. ★R9 Routing is a chain rather than a person: five pre-provisioned steps, each addressed to its own Approver_N__c Related User Field and gated on that field being populated, so a chain shorter than five simply skips the steps it does not use. ApprovalChainService resolves the chain at submit time — Account Owner, their manager, that manager&apos;s manager, ending at the first Regional Head — and freezes it onto the record, because an approval process can only address a stored User lookup and because a reorganisation mid-approval must not reroute an item somebody is already looking at.</description>

    <!--
      No entryCriteria: submission is always explicit, from Screen 3, and the submitting
      Apex has already checked ownership, resolved the chain and stamped Submitted_At__c.
      A duplicate entry test here would only be able to repeat that less precisely.
    -->

    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <showApprovalHistory>true</showApprovalHistory>

    <!--
      No <emailTemplate>: Option 1 was chosen for notification volume. Approvers set
      "Receive Approval Request Emails = Never" and are told once per submission by the
      aggregated email + bell from EventNotificationService, instead of once per invitee.
      Restoring per-request emails means adding a template here AND flipping that user
      setting back — the two must move together or approvers hear nothing at all.

      ★R9 With a chain, that aggregate is sent at two moments rather than one: at submit
      time for level 1, and by the Invitee_Level_Advanced flow for every level above it as
      the level below finishes. A chain whose upper levels are never told is a chain that
      stalls silently, which is the failure this arrangement exists to avoid.
    -->

    <!--
      ★R8 VIP__c and Remark__c join the page because they are the only two fields that
      say anything the approver cannot already infer: everything else here identifies the
      person, while these two are the AM's case for inviting them. An approval screen that
      shows only identity asks the approver to decide on a name.
    -->
    <approvalPageFields>
        <field>Invitee_Name__c</field>
        <field>Invitee_Title__c</field>
        <field>Invitee_Org__c</field>
        <field>VIP__c</field>
        <field>Remark__c</field>
        <field>Added_By__c</field>
        <field>Marketing_Event__c</field>
    </approvalPageFields>

    <initialSubmissionActions>
        <action>
            <name>Set_Status_Pending_Approval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Current_Level_1</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>

    <!--
      ★R9 One step per level, and three lines in each of them do the work:

        entryCriteria     NOT(ISBLANK(Approver_N__c))  - is there a level N on this row?
        ifCriteriaNotMet  ApproveRecord                - no: the chain ended below, finish
        rejectBehavior    RejectRequest                - any level's rejection ends the whole

      ApprovalChainService compacts the chain so the populated levels are always 1..k with
      no holes. That is what makes ifCriteriaNotMet safe here: the only steps it can reach
      are the ones past the end of the chain, never a gap in the middle, so "criteria not
      met" always means "this chain is finished" and never "skip somebody".

      Step 1 is the exception and fails closed instead. A blank Approver_1__c cannot happen —
      Approver_Required_When_Pending forbids the state at the database — but if it somehow
      did, ApproveRecord would approve an invitee nobody had looked at.
    -->
    <approvalStep>
        <fullName>Level_1_Account_Owner</fullName>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Set_Current_Level_2</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Approver_1__c</name>
                <type>relatedUserField</type>
            </approver>
        </assignedApprover>
        <description>Level 1: the Account Owner of the customer this invitee belongs to. requirement.md&apos;s first approver, and the control R5 gave up when it had no Account to ask.</description>
        <entryCriteria>
            <formula>NOT(ISBLANK(Approver_1__c))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>RejectRecord</ifCriteriaNotMet>
        <label>Level 1 - Account Owner</label>
        <name>Level_1_Account_Owner</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>

    <approvalStep>
        <fullName>Level_2_Manager</fullName>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Set_Current_Level_3</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Approver_2__c</name>
                <type>relatedUserField</type>
            </approver>
        </assignedApprover>
        <description>Level 2: the Account Owner&apos;s manager. Blank when the chain ended at level 1 — because level 1 is a Regional Head, or has no manager — and this step is then skipped.</description>
        <entryCriteria>
            <formula>NOT(ISBLANK(Approver_2__c))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Level 2 - Manager</label>
        <name>Level_2_Manager</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>

    <approvalStep>
        <fullName>Level_3_Manager</fullName>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Set_Current_Level_4</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Approver_3__c</name>
                <type>relatedUserField</type>
            </approver>
        </assignedApprover>
        <description>Level 3: the last level requirement.md&apos;s default reaches, and the one a Regional Head is most often found at.</description>
        <entryCriteria>
            <formula>NOT(ISBLANK(Approver_3__c))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Level 3 - Senior Manager</label>
        <name>Level_3_Manager</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>

    <approvalStep>
        <fullName>Level_4_Reserved</fullName>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Set_Current_Level_5</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Approver_4__c</name>
                <type>relatedUserField</type>
            </approver>
        </assignedApprover>
        <description>Level 4: unused at the shipped configuration and skipped. It is here so that raising Approval_Chain_Setting__mdt.Max_Levels_Above_Account_Owner__c buys a level with a setting rather than a deploy — which is what &quot;more levels are expected later&quot; costs when it is planned for in advance.</description>
        <entryCriteria>
            <formula>NOT(ISBLANK(Approver_4__c))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Level 4 - Reserved</label>
        <name>Level_4_Reserved</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>

    <approvalStep>
        <fullName>Level_5_Reserved</fullName>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Approver_5__c</name>
                <type>relatedUserField</type>
            </approver>
        </assignedApprover>
        <description>Level 5: unused, skipped, and the ceiling this metadata provides. No approval action — there is no level 6 to advance to. A chain longer than this costs a field, a step and a permission set entry; verify the platform&apos;s cap on steps per process before promising one.</description>
        <entryCriteria>
            <formula>NOT(ISBLANK(Approver_5__c))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Level 5 - Reserved</label>
        <name>Level_5_Reserved</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>

    <finalApprovalActions>
        <action>
            <name>Set_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stamp_Decided_At</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>

    <finalRejectionActions>
        <action>
            <name>Set_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stamp_Decided_At</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <!--
      Unlocked on rejection so re-adding a rejected invitee can still reset the row to
      Draft (the rule from Screen 3, unchanged). Locked-on-approval would be tidier but
      would break that path for a rejected-then-re-added contact.
    -->
    <finalRejectionRecordLock>false</finalRejectionRecordLock>

    <recordEditability>AdminOnly</recordEditability>
    <processOrder>1</processOrder>
</ApprovalProcess>

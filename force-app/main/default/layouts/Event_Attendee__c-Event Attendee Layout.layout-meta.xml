<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Person</label>
        <layoutColumns>
            <layoutItems><behavior>Required</behavior><field>Name</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Salutation__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>First_Name__c</field></layoutItems>
            <layoutItems><behavior>Required</behavior><field>Last_Name__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Other_Language_Name__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Edit</behavior><field>Title__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Other_Language_Job_Title__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Company__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Email__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Mobile__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Work_Phone__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Address__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <!--
      ★R8 The Contact link sits in its own section rather than beside the name fields,
      because it is the one thing on this page that points outside the project. Both
      items are read-only here: the link is written by a reconciliation run, and the
      checkbox is a formula over it.
    -->
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Org Reconciliation</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Contact__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Is_Known_Contact__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>Import</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Source_File__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Imported_On__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Unique_Key__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <!--
      The Event Invitees related list is what makes this page answer "which events has
      this person been invited to" — the question Event_History__c used to hold, now
      readable straight off the person. ★R6 It shows the event's name, date and type
      and whether they turned up, so the page answers the recommendation question
      ("what has this person actually shown up for?") without opening a report.
    -->
    <relatedLists>
        <fields>Event_Name__c</fields>
        <fields>Event_Date__c</fields>
        <fields>Event_Type__c</fields>
        <fields>Status__c</fields>
        <fields>Attended__c</fields>
        <fields>Added_By__c</fields>
        <relatedList>Event_Invitee__c.Event_Attendee__c</relatedList>
    </relatedLists>
</Layout>

    <!--
      ★R8 Read-only, and the object permission that would make the lookup legible is
      deliberately absent from this set: nothing here grants anything on Contact. An AM
      sees Is_Known_Contact__c either way; seeing *which* Contact requires a Read grant
      the org's admin makes, and that step is in DEPLOYMENT.md rather than in this file.
      The link itself is written by a reconciliation run, never by the import and never
      by hand — see the field description.
    -->
    <fieldPermissions>
        <field>Event_Attendee__c.Contact__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Attendee__c.Is_Known_Contact__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <!--
      Read-only for a user even though the import writes them: these three are the
      record's provenance, and a hand-edit would make Source_File__c a lie. The
      import runs in the user's context and can still set them, because Apex
      respects FLS only where the code asks it to — the point here is the UI.
    -->
    <fieldPermissions>
        <field>Event_Attendee__c.Source_File__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

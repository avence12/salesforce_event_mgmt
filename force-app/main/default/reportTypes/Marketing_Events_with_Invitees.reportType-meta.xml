<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Marketing_Events_with_Invitees</fullName>
    <label>Marketing Events with Event Invitees</label>
    <description>Screen 5. Replaces EventExportController and the approvedExport LWC: filtering, grouping, column choice, date ranges and CSV/XLSX export are all things a report already does. The Invitee_* formula fields read through to the Event Attendee, so the report needs no join past the junction.</description>
    <baseObject>Marketing_Event__c</baseObject>
    <category>other</category>
    <deployed>true</deployed>
    <join>
        <outerJoin>false</outerJoin>
        <relationship>Event_Invitees__r</relationship>
    </join>
    <sections>
        <masterLabel>Marketing Event</masterLabel>
        <columns><field>Name</field><table>Marketing_Event__c</table><checkedByDefault>true</checkedByDefault></columns>
        <columns><field>Event_Date__c</field><table>Marketing_Event__c</table><checkedByDefault>true</checkedByDefault></columns>
        <columns><field>Event_Type__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>
        <columns><field>Location__c</field><table>Marketing_Event__c</table><checkedByDefault>false</checkedByDefault></columns>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Event Attendee</label>
    <pluralLabel>Event Attendees</pluralLabel>
    <description>The people an imported list is about. R5 makes this the only thing Screen 1 writes: an attendee is a person we have on a list, held on our own object, with no Account, no Contact and no Lead behind it. One row per person, reused across every event — the link to an event is Event_Invitee__c, so inviting the same person to three events is three invitee rows against one attendee.</description>
    <nameField>
        <label>Attendee Name</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <!--
      Read/Write, and that is load-bearing rather than lazy. An event is shared: any
      AM may invite anyone on the imported list, and an approver has to be able to
      read the person they are deciding on. The old model got this from Account
      sharing; with no Account there is nothing to inherit from, so the object says
      it outright. Tightening this is a production lever, but it cannot be tightened
      without giving AMs some other route to each other's attendees.
    -->
    <sharingModel>ReadWrite</sharingModel>
    <externalSharingModel>Private</externalSharingModel>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <visibility>Public</visibility>
</CustomObject>

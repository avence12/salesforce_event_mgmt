        <editable>false</editable>
    </fieldPermissions>
    <!--
      ★R9 An approver reads the levels above and below their own, and edits none of them.
      Seeing the rest of the chain is part of deciding: "two more people will look at this"
      and "I am the last signature" are different decisions, and the row is where that is
      written down.
    -->
    <fieldPermissions>
        <field>Event_Invitee__c.Approver_1__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Approver_2__c</field>
        <readable>true</readable>

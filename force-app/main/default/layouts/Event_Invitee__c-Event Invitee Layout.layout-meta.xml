            <layoutItems><behavior>Readonly</behavior><field>Invitee_Name__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Invitee_Title__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Invitee_Org__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Status__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>Attended__c</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>VIP__c</field></layoutItems>

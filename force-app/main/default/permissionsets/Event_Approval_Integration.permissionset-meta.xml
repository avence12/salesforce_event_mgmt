<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Event Approval Integration</label>
    <description>Dedicated integration user for the on-prem approval middleware: minimal surface — the decision callback REST endpoint plus read access to the records it reconciles. Assign to the middleware's Connected App integration user only.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Marketing_Event__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Event_Invitee__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Status__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.External_Approval_Id__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Integration_Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.External_Approver__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Decision_Comment__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Submitted_At__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Decided_At__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>ExternalApprovalRestService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>

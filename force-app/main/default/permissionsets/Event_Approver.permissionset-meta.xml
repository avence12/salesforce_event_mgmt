        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Attended__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <!--
      ★R8 Both readable, neither editable: they are the AM's account of why this person
      is worth inviting, and an approver reads that account rather than editing it.
      Remark__c is on the approval page for the same reason.
    -->
    <fieldPermissions>
        <field>Event_Invitee__c.VIP__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Remark__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event_Invitee__c.Event_Name__c</field>

# Ignore non-source files
package.json
package-lock.json
node_modules
scripts
**/*.md
# ★R9 …but not Custom Metadata *records*, whose files end in .md-meta.xml. The glob above
# should not match them, and this negation makes sure a future tooling version cannot decide
# otherwise and silently leave Approval_Chain_Setting.Default out of the deploy.
!force-app/main/default/customMetadata/**
.gstack
coverage

# Quality tooling — local only, never deployed to an org
eslint.config.js
jest.config.js
force-app/test
**/__tests__/**
